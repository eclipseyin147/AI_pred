        "history_size": 30
      },
      "adamw": {
        "learning_rate": 0.001,
        "beta1": 0.9,
        "beta2": 0.999,
        "eps": 1e-8,
        "weight_decay": 0.001
      }
    },
    "normalization": {
      "enabled": true,
      "method": "minmax_neg1_1"
    },
    "goal_loss": 1e-9,
    "max_iterations": 1000,
    "target_r2": 0.85,
    "print_interval": 10,
    "window_size": 5,
    "train_samples": 300,
    "num_rows": 900,
    "rr": 4.0,
    "input_columns": [4, 5, 8, 10],
    "output_column": 11,
    "time_column": 0
  },
  "faultdiag": {
    "submode": "cnn",
    "input_mat_path": "Copy_of_select-model fault data.mat",
    "output_model_path": "fault_best_model.pt",
    "control_file_path": "control.json",
    "status_file_path": "status.json",
    "hidden_layers": 2,
    "hidden_layer_neurons": [64, 48],
    "learning_rate": 0.001,
    "epochs": 100,
    "batch_size": 26,
    "optimizer": "adam",
    "use_gpu": true,
    "data_var": "XTrain2",
    "label_var": "YTrain2",
    "val_data_var": "XText2",
    "val_label_var": "YText2",
    "train_split": 0.8,
    "validation_frequency": 10,
    "normalization": {
      "enabled": true,
      "method": "rescale_symmetric"
    },
    "cnn_filter_size": 2,
    "cnn_num_filters": 32,
    "tcn_num_blocks": 4,
    "tcn_num_filters": 64,
    "tcn_filter_size": 3,
