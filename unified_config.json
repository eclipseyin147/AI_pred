    "epochs": 40,
    "batch_size": 60000,
    "optimizer_type": "lbfgs",
    "optimizer": {
      "lbfgs": {
        "learning_rate": 0.005,
        "max_iter": 200,
        "max_eval": 1200,
        "tolerance_grad": 1e-12,
